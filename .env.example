DATABASE_URL=sqlite+aiosqlite:///./telepc.db
SECRET_KEY=change-this-in-local-dev
INTERNAL_API_SECRET=change-this-relay-api-internal-secret
WS_TICKET_TTL_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=480
ARTIFACT_ROOT=./artifacts
RELAY_URL=ws://localhost:8001
API_URL=http://localhost:8000
MACHINE_TOKEN=
SANDBOX_ROOT=./sandbox
REQUIRE_CONSENT=true
AGENT_MODE=fake
ALLOWED_UPLOAD_EXT=.py,.ps1,.sh,.cmd,.txt,.csv,.json
